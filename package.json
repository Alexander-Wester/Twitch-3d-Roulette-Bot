{
  "name": "twitch-3d-roulette-bot",
  "version": "1.5.0",
  "description": "Desktop Twitch roulette bot with a physics-driven OBS overlay.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "start:bot": "node src/twitchBot.js",
    "auth:bot": "node src/twitchAuth.js bot",
    "auth:broadcaster": "node src/twitchAuth.js broadcaster",
    "test": "echo \"No automated tests configured yet\"",
    "package:win": "electron-packager . \"Rhinos Roulette Bot\" --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=\"^/dist($|/)\" --ignore=\"^/data($|/)\" --ignore=\"^/\\.env$\" --ignore=\"^/tokens\\.json$\" --ignore=\"\\.tokens\\.json$\" --ignore=\"roulette\\.db$\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexander-Wester/Twitch-3d-Roulette-Bot.git"
  },
  "keywords": [
    "twitch",
    "roulette",
    "obs",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Alexander-Wester/Twitch-3d-Roulette-Bot/issues"
  },
  "homepage": "https://github.com/Alexander-Wester/Twitch-3d-Roulette-Bot#readme",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "dotenv": "^17.4.2",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "@electron/packager": "20.3.0"
  }
}
